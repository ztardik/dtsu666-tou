# DTSU666 logger - credentials and meter addressing.
#
# Install as /opt/dtsu666/etc/secrets.ini with ownership root:dtsu666 and
# mode 0640 (or 0600 if only root needs to read it):
#     sudo install -m 0640 -o root -g dtsu666 secrets.ini /opt/dtsu666/etc/
#
# This file is the ONLY place credentials may appear.  The backup bundle
# stores it, so keep the bundle at mode 0600 as well.

[SERIAL]
# Serial device for the meter.  /dev/ttyDTSU666 is the stable alias created
# by the udev rule; /dev/ttyUSB0 works too but can move between ports.
port = /dev/ttyUSB0
baudrate = 9600
timeout = 1.0
# Modbus slave address of the meter (1-247).
address = 1

[MQTT]
host = 127.0.0.1
port = 1883
username = REPLACE_ME
password = REPLACE_ME

# HEP photo-reference corrections, keyed 1, 2, 3 ...
#   <n> = "YYYY-MM-DD HH:MM, <VT kWh>, <NT kWh>, <note>"
# The timestamp must be a whole minute that exists in the stored readings.
# Once configured the operational status becomes "missing" until enough
# data surrounds the anchor, then "active".
[HEP Correction]
